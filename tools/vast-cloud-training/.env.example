# =============================================================================
# Vast.ai Cloud Training Environment
# =============================================================================
# Copy to .env and fill in your values
# Used by local scripts (upload/download)
# =============================================================================

# AWS Credentials
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your-secret-key

# S3 Configuration
S3_BUCKET=omnitransfer-training
S3_REGION=us-east-1
S3_STORAGE_CLASS=STANDARD

# Default S3 prefix for training data
S3_PREFIX=processed/omnitransfer_unified_5task
