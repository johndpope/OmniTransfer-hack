# Vast.ai OmniTransfer Training - Configuration
# Copy this to terraform.tfvars and fill in your credentials
# NEVER commit terraform.tfvars to git!

# Required: Your API keys
vast_api_key          = "YOUR_VASTAI_API_KEY"
aws_access_key_id     = "YOUR_AWS_ACCESS_KEY"
aws_secret_access_key = "YOUR_AWS_SECRET_KEY"

# Optional: Model download and experiment tracking
hf_token              = "YOUR_HF_TOKEN"
wandb_api_key         = "YOUR_WANDB_KEY"
wandb_project         = "omnitransfer-unified"

# S3 Configuration (match your upload destination)
s3_bucket             = "imf-infinity-latents"
s3_region             = "us-east-1"
s3_data_prefix        = "omnitransfer/training_data"

# GPU Selection (48GB+ at <$1/hr for OmniTransfer)
# Options: A6000 (48GB), A100-40GB, L40 (48GB), L40S (48GB)
preferred_gpu         = ""  # Leave empty for cheapest 48GB+ option

# Instance Configuration
num_gpus              = 1
disk_gb               = 150
interruptible         = false  # Set true for spot pricing

# Training Configuration
training_config       = "ltx2_omnitransfer_unified_5task.yaml"
training_steps        = 5000
max_runtime_hours     = 3     # Auto-shutdown after 3 hours
checkpoint_interval   = 500
