# OmniTransfer S3 Video Storage Credentials
# Copy to .env and fill in your values
# DO NOT COMMIT THE .env FILE!

# =============================================================================
# AWS S3 Configuration (Required)
# =============================================================================
AWS_ACCESS_KEY_ID=AKIA...your-access-key...
AWS_SECRET_ACCESS_KEY=your-secret-access-key-here
S3_BUCKET=omnitransfer-training-videos
S3_REGION=us-east-1

# =============================================================================
# HuggingFace (Optional - for model downloads)
# =============================================================================
HF_TOKEN=hf_your_token_here

# =============================================================================
# Weights & Biases (Optional - for training logging)
# =============================================================================
WANDB_API_KEY=your_wandb_api_key_here

# =============================================================================
# Video Processing Settings
# =============================================================================
# Maximum video duration in seconds (videos longer will be split)
MAX_VIDEO_DURATION=10

# Target resolution for encoding
TARGET_HEIGHT=512
TARGET_WIDTH=512

# Maximum frames (must be k*8+1 for LTX-2)
MAX_FRAMES=33

# =============================================================================
# Sync Settings
# =============================================================================
# Upload only (don't download changes)
UPLOAD_ONLY=false

# Delete remote files not present locally (DANGEROUS!)
DELETE_REMOTE=false

# S3 storage class (STANDARD, INTELLIGENT_TIERING, GLACIER, etc.)
S3_STORAGE_CLASS=STANDARD
